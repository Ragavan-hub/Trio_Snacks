# Example: postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:[Ragav%40supabase]@db.oddzrncrpqgjwbczsutr.supabase.co:5432/postgres

# Optional: Local development server port (defaults to 5000)
PORT=5000
